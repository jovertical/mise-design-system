{
  "name": "mise-docs",
  "private": true,
  "type": "module",
  "imports": {
    "#modules/*": "./src/modules/*"
  },
  "scripts": {
    "dev": "vite dev --port 5190",
    "build": "vite build",
    "theme": "mise-theme mise.theme.js -o src/mise-theme.css",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "biome check .",
    "test:unit": "vitest run",
    "test": "pnpm check && pnpm lint && pnpm test:unit",
    "assemble": "tsx scripts/assemble-pages.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@jovertical/mise-design-system": "workspace:*",
    "@tabler/icons-svelte-runes": "^3.51.0",
    "@tanstack/svelte-table": "^9.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.0",
    "mdsvex": "^0.12.8",
    "shiki": "^4.6.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
