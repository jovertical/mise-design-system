{
  "name": "mise-logistics-example",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev --port 5180",
    "build": "vite build",
    "preview": "vite preview --port 5181",
    "theme": "mise-theme mise.theme.js -o src/mise-theme.css",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "biome check .",
    "test:unit": "vitest run",
    "test": "pnpm check && pnpm lint && pnpm test:unit",
    "smoke": "pnpm build && tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@jovertical/mise-design-system": "workspace:*",
    "@lucide/svelte": "^1.70.0",
    "@tanstack/svelte-table": "^9.3.1",
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.1",
    "formsnap": "^2.1.0",
    "layerchart": "^2.9.2",
    "sveltekit-superforms": "^3.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
